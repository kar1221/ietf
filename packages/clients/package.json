      "default": "./src/mailarchive/message.ts"
    },
    "./datatracker": {
      "types": "./src/datatracker/client.ts",
      "default": "./src/datatracker/client.ts"
    },
    "./datatracker/errors": {
      "types": "./src/datatracker/errors.ts",
      "default": "./src/datatracker/errors.ts"
    },
    "./datatracker/types": {
