{
  "name": "@ietf/clients",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "jsdom": "^30.1.2",
    "postal-mime": "^4.0.5",
    "zod": "^4.4.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./mailarchive": {
      "types": "./src/mailarchive/client.ts",
      "default": "./src/mailarchive/client.ts"
    },
    "./mailarchive/types": {
      "types": "./src/mailarchive/types.ts",
      "default": "./src/mailarchive/types.ts"
    },
    "./mailarchive/errors": {
      "types": "./src/mailarchive/errors.ts",
      "default": "./src/mailarchive/errors.ts"
    },
    "./mailarchive/message": {
