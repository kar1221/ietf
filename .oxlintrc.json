{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "node", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": [
    "**/*.snap",
    "coverage",
    "lib",
    "node_modules",
    "pnpm-lock.yaml",
    "**/*.test.ts"
  ],
  "rules": {
    "typescript/no-unsafe-type-assertion": "off"
  }
}
